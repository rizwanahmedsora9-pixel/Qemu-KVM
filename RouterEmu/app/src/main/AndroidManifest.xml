<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- QEMU's user-mode networking (hostfwd) needs plain internet access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required to start/keep alive the emulator foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ requires runtime consent to post the foreground-service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Downloading default kernel/disk assets over the network -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".RouterEmuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RouterEmu"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RouterEmu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          android:foregroundServiceType="specialUse" is the correct declaration
          (API 34+) for a service that doesn't map to one of the predefined
          types (mediaPlayback, location, etc.) — a local device emulator
          process is exactly that "special use" case. The
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE string is required alongside it and
          is shown to users/Play if they inspect why the app runs in the
          foreground.
        -->
        <service
            android:name=".QemuService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_device_emulation" />
        </service>

    </application>
</manifest>
